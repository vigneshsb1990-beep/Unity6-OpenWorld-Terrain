{
  "name": "forest-palace-fort",
  "version": "0.1.0",
  "private": true,
  "description": "Android 3D game: forest terrain with a giant palace and fort, 2K procedural textures.",
  "type": "module",
  "scripts": {
    "start": "npx --yes http-server www -p 8080 -c-1",
    "terrain:fetch": "node scripts/fetch-sketchfab.mjs",
    "sync": "cap sync",
    "add:android": "cap add android",
    "open:android": "cap open android",
    "build:android": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "http-server": "^14.1.1",
    "three": "^0.187.0"
  }
}